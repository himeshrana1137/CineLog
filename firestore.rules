rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidWatchedMedia(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.movieId is int &&
             data.movieId > 0 &&
             (!('mediaType' in data) || data.mediaType in ['movie', 'tv']) &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.rating is number &&
             data.rating >= 0 &&
             data.rating <= 10 &&
             (!('posterPath' in data) || data.posterPath == null || (data.posterPath is string && data.posterPath.size() <= 500)) &&
             (!('releaseDate' in data) || data.releaseDate == null || (data.releaseDate is string && data.releaseDate.size() <= 32)) &&
             (!('userRating' in data) || (data.userRating is int && data.userRating >= 0 && data.userRating <= 5)) &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 1000)) &&
             (!('reaction' in data) || data.reaction in ['', 'mind_blown', 'emotional', 'masterpiece', 'hilarious', 'boring']) &&
             (!('originalLanguage' in data) || (data.originalLanguage is string && data.originalLanguage.size() <= 16)) &&
             (!('overview' in data) || data.overview == null || (data.overview is string && data.overview.size() <= 4000)) &&
             (!('genres' in data) || (data.genres is list && data.genres.size() <= 10 && (data.genres.size() == 0 || data.genres[0] is string))) &&
             (!('cast' in data) || (data.cast is list && data.cast.size() <= 15 && (data.cast.size() == 0 || data.cast[0] is string))) &&
             (!('directors' in data) || (data.directors is list && data.directors.size() <= 10 && (data.directors.size() == 0 || data.directors[0] is string))) &&
             (!('runtime' in data) || (data.runtime is int && data.runtime >= 0 && data.runtime <= 2000)) &&
             (!('numberOfSeasons' in data) || (data.numberOfSeasons is int && data.numberOfSeasons >= 0 && data.numberOfSeasons <= 200)) &&
             (!('numberOfEpisodes' in data) || (data.numberOfEpisodes is int && data.numberOfEpisodes >= 0 && data.numberOfEpisodes <= 50000)) &&
              (!('watchedSeason' in data) || (data.watchedSeason is int && data.watchedSeason >= 0 && data.watchedSeason <= 200)) &&
              (!('status' in data) || data.status in ['', 'NOT_STARTED', 'WATCHING', 'COMPLETED']) &&
              (!('watchedEpisodesCount' in data) || (data.watchedEpisodesCount is int && data.watchedEpisodesCount >= 0 && data.watchedEpisodesCount <= 50000)) &&
              (!('watchedSeasonsCount' in data) || (data.watchedSeasonsCount is int && data.watchedSeasonsCount >= 0 && data.watchedSeasonsCount <= 200)) &&
              (!('watchedRuntimeMinutes' in data) || (data.watchedRuntimeMinutes is int && data.watchedRuntimeMinutes >= 0 && data.watchedRuntimeMinutes <= 5000000)) &&
              (!('nextUpSeason' in data) || (data.nextUpSeason is int && data.nextUpSeason >= 0 && data.nextUpSeason <= 200)) &&
              (!('nextUpEpisode' in data) || (data.nextUpEpisode is int && data.nextUpEpisode >= 0 && data.nextUpEpisode <= 5000)) &&
              (!('currentSeason' in data) || (data.currentSeason is int && data.currentSeason >= 0 && data.currentSeason <= 200)) &&
              (!('watchLog' in data) || (data.watchLog is list && data.watchLog.size() <= 500 && (data.watchLog.size() == 0 || data.watchLog[0] is string))) &&
              data.watchedAt is timestamp &&
              data.watchedAt <= request.time &&
              data.updatedAt is timestamp &&
              data.updatedAt <= request.time;
    }

    function isValidWatchlistItem(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.movieId is int &&
             data.movieId > 0 &&
             data.mediaType in ['movie', 'tv'] &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.rating is number &&
             data.rating >= 0 &&
             data.rating <= 10 &&
             (!('posterPath' in data) || data.posterPath == null || (data.posterPath is string && data.posterPath.size() <= 500)) &&
             (!('releaseDate' in data) || data.releaseDate == null || (data.releaseDate is string && data.releaseDate.size() <= 32)) &&
             (!('overview' in data) || data.overview == null || (data.overview is string && data.overview.size() <= 4000)) &&
             (!('originalLanguage' in data) || (data.originalLanguage is string && data.originalLanguage.size() <= 16)) &&
             (!('genres' in data) || (data.genres is list && data.genres.size() <= 10 && (data.genres.size() == 0 || data.genres[0] is string))) &&
             (!('runtime' in data) || (data.runtime is int && data.runtime >= 0 && data.runtime <= 2000)) &&
             (!('numberOfSeasons' in data) || (data.numberOfSeasons is int && data.numberOfSeasons >= 0 && data.numberOfSeasons <= 200)) &&
             (!('numberOfEpisodes' in data) || (data.numberOfEpisodes is int && data.numberOfEpisodes >= 0 && data.numberOfEpisodes <= 50000)) &&
             data.addedAt is timestamp &&
             data.addedAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCustomList(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.items is list &&
             data.items.size() <= 300 &&
             (data.items.size() == 0 || (
               data.items[0] is map &&
               data.items[0].movieId is int &&
               data.items[0].title is string
             )) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidUserSettings(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.accentPreset in ['red', 'yellow', 'blue', 'purple', 'neon_green', 'custom'] &&
             data.accentHex is string &&
             data.accentHex.matches('^#[0-9A-Fa-f]{6}$') &&
             (!('tvMigrationCompleted' in data) || data.tvMigrationCompleted is bool) &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidWatchedSeason(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.tvId is int &&
             data.tvId > 0 &&
             data.seasonNumber is int &&
             data.seasonNumber >= 0 &&
             data.seasonNumber <= 200 &&
             data.episodeCount is int &&
             data.episodeCount >= 0 &&
             data.episodeCount <= 2000 &&
             data.watched is bool &&
             data.watchedEpisodes is list &&
             data.watchedEpisodes.size() <= 2000 &&
             (data.watchedEpisodes.size() == 0 || data.watchedEpisodes[0] is int) &&
             (!('watchedRuntimeMinutes' in data) || (data.watchedRuntimeMinutes is int && data.watchedRuntimeMinutes >= 0 && data.watchedRuntimeMinutes <= 500000)) &&
             (!('watchedAt' in data) || data.watchedAt == null || (data.watchedAt is timestamp && data.watchedAt <= request.time)) &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/watched/{watchedId} {
      allow get: if isOwner(userId) && isValidId(watchedId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(watchedId) &&
                       incoming().keys().hasAll(['userId', 'movieId', 'mediaType', 'title', 'rating', 'watchedAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'movieId', 'mediaType', 'title', 'posterPath', 'releaseDate',
                         'rating', 'userRating', 'note', 'reaction', 'originalLanguage',
                         'overview', 'genres', 'cast', 'directors',
                         'runtime', 'numberOfSeasons', 'numberOfEpisodes', 'watchedSeason',
                         'status', 'watchedEpisodesCount', 'watchedSeasonsCount', 'watchedRuntimeMinutes',
                         'nextUpSeason', 'nextUpEpisode', 'currentSeason',
                         'watchLog', 'watchedAt', 'updatedAt'
                       ]) &&
                       isValidWatchedMedia(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(watchedId) &&
                       isValidWatchedMedia(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().movieId == existing().movieId &&
                       (!('mediaType' in existing()) || incoming().mediaType == existing().mediaType) &&
                       incoming().watchedAt == existing().watchedAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'userRating', 'note', 'reaction', 'originalLanguage',
                         'title', 'posterPath', 'releaseDate',
                         'rating', 'overview', 'genres', 'cast', 'directors', 'runtime',
                         'numberOfSeasons', 'numberOfEpisodes', 'watchedSeason',
                         'status', 'watchedEpisodesCount', 'watchedSeasonsCount', 'watchedRuntimeMinutes',
                         'nextUpSeason', 'nextUpEpisode', 'currentSeason',
                         'watchLog', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(watchedId);
    }

    match /users/{uid}/watched/{tvId}/seasons/{seasonId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId}/watchlist/{watchlistId} {
      allow get: if isOwner(userId) && isValidId(watchlistId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(watchlistId) &&
                       incoming().keys().hasAll(['userId', 'movieId', 'mediaType', 'title', 'rating', 'addedAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'userId', 'movieId', 'mediaType', 'title', 'posterPath', 'releaseDate',
                         'rating', 'overview', 'originalLanguage', 'genres',
                         'runtime', 'numberOfSeasons', 'numberOfEpisodes',
                         'addedAt', 'updatedAt'
                       ]) &&
                       isValidWatchlistItem(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(watchlistId) &&
                       isValidWatchlistItem(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().movieId == existing().movieId &&
                       incoming().mediaType == existing().mediaType &&
                       incoming().addedAt == existing().addedAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'posterPath', 'releaseDate', 'rating',
                         'overview', 'originalLanguage', 'genres', 'runtime',
                         'numberOfSeasons', 'numberOfEpisodes', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(watchlistId);
    }

    match /users/{userId}/lists/{listId} {
      allow get: if isOwner(userId) && isValidId(listId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(listId) &&
                       incoming().keys().hasAll(['userId', 'name', 'items', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'description', 'items', 'createdAt', 'updatedAt']) &&
                       isValidCustomList(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(listId) &&
                       isValidCustomList(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'items', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(listId);
    }

    match /users/{userId}/settings/{settingId} {
      allow get: if isOwner(userId) && settingId == 'preferences';
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       settingId == 'preferences' &&
                       incoming().keys().hasAll(['userId', 'accentPreset', 'accentHex', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'accentPreset', 'accentHex', 'tvMigrationCompleted', 'updatedAt']) &&
                       isValidUserSettings(incoming(), userId);

      allow update: if isOwner(userId) &&
                       settingId == 'preferences' &&
                       incoming().keys().hasAll(['userId', 'accentPreset', 'accentHex', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'accentPreset', 'accentHex', 'tvMigrationCompleted', 'updatedAt']) &&
                       isValidUserSettings(incoming(), userId) &&
                       incoming().userId == existing().userId;

      allow delete: if isOwner(userId) && settingId == 'preferences';
    }
  }
}
